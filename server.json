{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alimbenhelal-pro/alm-xpp-mcp",
  "version": "1.5.0",
  "title": "ALM X++ MCP Server",
  "description": "D365 F&O: 90 AI tools over 200K+ objects, 25M+ cross-refs, 24M+ label translations.",
  "websiteUrl": "https://www.almxpp.com",
  "icons": [
    {
      "src": "https://www.almxpp.com/img/logo.png",
      "mimeType": "image/png",
      "theme": "light"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "almxppmcp",
      "version": "1.5.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "ALMXPPMCP_API_KEY",
          "description": "Your ALM X++ license key -- request one at https://www.almxpp.com",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.almxpp.com/mcp",
      "variables": {
        "apiKey": {
          "description": "Your ALM X++ license key -- request one at https://www.almxpp.com",
          "required": true,
          "secret": true
        }
      }
    }
  ],
  "repository": {
    "url": "https://github.com/alimbenhelal-pro/ALM-XPP-MCP",
    "source": "github"
  }
}
